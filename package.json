{
  "name": "garage-guru-agentic-sdlc-demo",
  "private": true,
  "version": "1.0.0",
  "description": "GarageGuru agentic SDLC — Node API, React web, Jira GG, GitHub Actions.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "start": "bash scripts/start.sh",
    "demo": "bash scripts/start.sh",
    "start:api": "npm run start --workspace=@garageguru/api",
    "start:web": "npm run dev --workspace=@garageguru/web",
    "test": "npm test --workspaces --if-present && npm run test:policy",
    "test:policy": "cd packages/booking_policy && dart pub get && dart test",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspace=@garageguru/web"
  }
}
